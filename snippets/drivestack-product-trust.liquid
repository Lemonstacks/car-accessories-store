{% comment %}
  DriveStack Product Trust Badges
  Renders honest trust badges + an accurate delivery line on product pages.

  ETHICS: No "fast shipping" claim — real window is 8-30 days imported. We frame the
  honest advantage instead: tracked delivery + SA-based support.
  Rationale: transaction/delivery risk drives abandonment [STRONG - MDPI JTAER 2025];
  trust is the mediator [STRONG]; delivery claims must be accurate [ethics].

  Optional params (all have honest defaults):
    delivery_badge_label - default "Tracked Delivery"
    delivery_line        - default honest dispatch/tracking/support line
    show_delivery_line   - default true

  Usage: {% render 'drivestack-product-trust' %}
     or: {% render 'drivestack-product-trust', delivery_badge_label: 'Tracked Delivery', show_delivery_line: true %}
{% endcomment %}

{%- liquid
  assign delivery_badge_label = delivery_badge_label | default: 'Tracked Delivery'
  assign delivery_line = delivery_line | default: 'Dispatched in 1-2 business days · Delivered with full tracking · Backed by SA-based support.'
  if show_delivery_line == nil
    assign show_delivery_line = true
  endif
-%}

<div class="ds-product-trust">
  <div class="ds-product-trust__item">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
    </svg>
    <span>Secure Checkout</span>
  </div>

  <div class="ds-product-trust__item">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="1" y="3" width="15" height="13"/>
      <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
      <circle cx="5.5" cy="18.5" r="2.5"/>
      <circle cx="18.5" cy="18.5" r="2.5"/>
    </svg>
    <span>{{ delivery_badge_label }}</span>
  </div>

  <div class="ds-product-trust__item">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="1 4 1 10 7 10"/>
      <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
    </svg>
    <span>30-Day Returns</span>
  </div>

  <div class="ds-product-trust__item">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
    </svg>
    <span>Premium Quality</span>
  </div>
</div>

{%- if show_delivery_line and delivery_line != blank -%}
  <p class="ds-product-delivery-line">{{ delivery_line }}</p>
{%- endif -%}
