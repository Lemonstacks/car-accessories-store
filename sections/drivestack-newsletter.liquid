{% comment %}
  DriveStack Newsletter — Split two-column layout
{% endcomment %}
{{ 'drivestack-custom.css' | asset_url | stylesheet_tag }}

<section class="ds-newsletter" aria-label="{{ section.settings.heading | default: 'Newsletter' | escape }}">
  <div class="ds-newsletter__container">
    <div class="ds-newsletter__copy">
      {% if section.settings.heading != blank %}
        <h2 class="ds-newsletter__title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="ds-newsletter__subtitle">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="ds-newsletter__form-wrap">
      {% form 'customer', id: 'ds-newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {% if form.errors %}
          <div class="ds-newsletter__error" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}
        {% if form.posted_successfully? %}
          <p class="ds-newsletter__success" role="status">{{ section.settings.success_message | default: 'Thanks for subscribing!' }}</p>
        {% else %}
          <div class="ds-newsletter__form">
            <label for="ds-newsletter-email" class="visually-hidden">Email</label>
            <input type="email" name="contact[email]" id="ds-newsletter-email" class="ds-newsletter__input"
              placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}"
              required autocomplete="email" aria-required="true">
            <button type="submit" class="ds-newsletter__button">{{ section.settings.button_label | default: 'Subscribe' }}</button>
          </div>
        {% endif %}
      {% endform %}
      {% if section.settings.disclaimer != blank %}
        <p class="ds-newsletter__disclaimer">{{ section.settings.disclaimer }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DriveStack Newsletter",
  "tag": "section",
  "class": "drivestack-newsletter-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the DriveStack Community" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Get exclusive deals, new arrivals, and car care tips." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks for subscribing!" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "We respect your privacy. Unsubscribe anytime." }
  ],
  "presets": [{ "name": "DriveStack Newsletter" }]
}
{% endschema %}
