{% comment %}
  DriveStack Fitment / Compatibility Row

  Renders a "Compatibility" line from the product metafield:
    namespace: custom
    key:       fitment
    type:      single_line_text_field OR multi_line_text_field

  ETHICS: If the metafield is empty, this renders NOTHING. Never fabricate a fit.
  The real per-product fitment text is entered in Shopify admin via the metafield.

  Rationale: when buyers can't touch the product, presentation is the critical
  quality clue [STRONG - Frontiers Psychol. 2023, 14:1124675]; accurate fitment
  reduces wrong-item returns [SOFT direction].

  Usage on the product page:
    {% render 'drivestack-fitment', product: product %}
{% endcomment %}

{%- liquid
  assign fitment = product.metafields.custom.fitment
  assign fitment_value = fitment.value | default: fitment
-%}

{%- if fitment_value != blank -%}
  {{ 'drivestack-custom.css' | asset_url | stylesheet_tag }}
  <div class="ds-fitment">
    <span class="ds-fitment__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
        <polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
    </span>
    <div class="ds-fitment__body">
      <span class="ds-fitment__label">Compatibility</span>
      <span class="ds-fitment__value">{{ fitment_value }}</span>
    </div>
  </div>
{%- endif -%}
