{% comment %}
  DriveStack Reviews — Dark bg, blue left-border cards, large quote marks
{% endcomment %}
{{ 'drivestack-custom.css' | asset_url | stylesheet_tag }}

<section class="ds-reviews" aria-label="{{ section.settings.heading | default: 'Reviews' | escape }}">
  <div class="ds-reviews__container">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="ds-reviews__header">
        {% if section.settings.heading != blank %}
          <h2 class="ds-reviews__title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="ds-reviews__subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% assign testimonial_blocks = section.blocks | where: "type", "testimonial" %}
    {% if testimonial_blocks.size > 0 %}
      <div class="ds-reviews__grid">
        {% for block in testimonial_blocks %}
          <article class="ds-review-card" {{ block.shopify_attributes }}>
            <div class="ds-review-card__stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
              {% for i in (1..5) %}
                {% if i <= block.settings.rating %}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                {% else %}
                  <svg viewBox="0 0 24 24" aria-hidden="true" style="opacity:.2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                {% endif %}
              {% endfor %}
            </div>
            {% if block.settings.text != blank %}
              <p class="ds-review-card__text">"{{ block.settings.text }}"</p>
            {% endif %}
            {% if block.settings.author != blank %}
              <p class="ds-review-card__author">{{ block.settings.author }}</p>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}

    {% assign app_blocks = section.blocks | where: "type", "@app" %}
    {% if app_blocks.size > 0 %}
      <div class="ds-reviews__app-container">
        {% for block in app_blocks %}{% render block %}{% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "DriveStack Reviews",
  "tag": "section",
  "class": "drivestack-reviews-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Our Customers Say" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Trusted by thousands of drivers worldwide." }
  ],
  "blocks": [
    { "type": "testimonial", "name": "Testimonial", "limit": 6, "settings": [
      { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "textarea", "id": "text", "label": "Review text", "default": "Incredible quality and fast shipping. My car interior looks amazing now." },
      { "type": "text", "id": "author", "label": "Author", "default": "Alex M." }
    ]},
    { "type": "@app" }
  ],
  "presets": [{
    "name": "DriveStack Reviews",
    "blocks": [
      { "type": "testimonial", "settings": { "rating": 5, "text": "Incredible quality and fast shipping. My car interior looks amazing now.", "author": "Alex M." } },
      { "type": "testimonial", "settings": { "rating": 5, "text": "The LED ambient lights completely transformed my driving experience. Worth every penny.", "author": "Sarah K." } },
      { "type": "testimonial", "settings": { "rating": 5, "text": "Best car accessories store I've found. Premium materials and great customer service.", "author": "James R." } }
    ]
  }]
}
{% endschema %}
