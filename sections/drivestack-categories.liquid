{% comment %}
  DriveStack Categories — Dark full-bleed cards, bottom-anchored text
{% endcomment %}
{{ 'drivestack-custom.css' | asset_url | stylesheet_tag }}

<section class="ds-categories" aria-label="{{ section.settings.heading | default: 'Categories' | escape }}">
  {% if section.settings.heading != blank or section.settings.subheading != blank %}
    <div class="ds-categories__header">
      {% if section.settings.heading != blank %}
        <h2 class="ds-categories__title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="ds-categories__subtitle">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ds-categories__grid">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link | default: '#' }}" class="ds-category-card" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <div class="ds-category-card__image">
            {{ block.settings.image | image_url: width: 800 | image_tag:
              loading: 'lazy',
              sizes: '(max-width: 549px) 50vw, (max-width: 989px) 50vw, 25vw',
              widths: '400,600,800',
              alt: block.settings.title }}
          </div>
        {% endif %}
        <div class="ds-category-card__overlay"></div>
        <div class="ds-category-card__body">
          <span class="ds-category-card__title">{{ block.settings.title }}</span>
          <span class="ds-category-card__arrow">Explore →</span>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "DriveStack Categories",
  "tag": "section",
  "class": "drivestack-categories-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Precision accessories for every build." }
  ],
  "blocks": [{
    "type": "category",
    "name": "Category",
    "limit": 8,
    "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Category" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "image_picker", "id": "image", "label": "Card image", "info": "Portrait aspect ratio works best (3:4)." }
    ]
  }],
  "presets": [{
    "name": "DriveStack Categories",
    "blocks": [
      { "type": "category", "settings": { "title": "Interior" } },
      { "type": "category", "settings": { "title": "Exterior" } },
      { "type": "category", "settings": { "title": "Electronics" } },
      { "type": "category", "settings": { "title": "Detailing" } }
    ]
  }]
}
{% endschema %}
