{% comment %}
  DriveStack Product Features
  Icon + title + description cards displayed alongside product images.
  Add to product pages via Theme Editor.
{% endcomment %}

{{ 'drivestack-custom.css' | asset_url | stylesheet_tag }}

<section class="ds-pf" aria-label="{{ section.settings.eyebrow | default: 'Features' | escape }}">
  <div class="ds-pf__container">
    {% if section.settings.eyebrow != blank %}
      <p class="ds-pf__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="ds-pf__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="ds-pf__list">
      {% for block in section.blocks %}
        <div class="ds-pf__card" {{ block.shopify_attributes }}>
          <div class="ds-pf__icon">
            {% case block.settings.icon %}
              {% when 'bolt' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              {% when 'shield' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {% when 'zap' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
              {% when 'tool' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
              {% when 'truck' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              {% when 'star' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {% when 'usb' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 18v-6"/><path d="M8 18v-1a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v1"/><rect x="10" y="18" width="4" height="4" rx="1"/><path d="M12 12V2"/><path d="M7 7l5-5 5 5"/></svg>
              {% when 'light' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z"/></svg>
              {% when 'check' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              {% when 'droplet' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            {% endcase %}
          </div>
          <div class="ds-pf__text">
            {% if block.settings.title != blank %}
              <h3 class="ds-pf__title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="ds-pf__desc">{{ block.settings.description }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Features",
  "tag": "section",
  "class": "drivestack-product-features-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "CORE FEATURES" },
    { "type": "text", "id": "heading", "label": "Heading (optional)" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 8,
      "settings": [
        {
          "type": "paragraph",
          "content": "Enter a feature that is TRUE for this specific product. Do not claim universal fit or tool-free install unless it genuinely applies. Pull wording from the product's real specifications."
        },
        { "type": "text", "id": "title", "label": "Title", "default": "" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "bolt", "options": [
          { "value": "bolt", "label": "Bolt / Power" },
          { "value": "shield", "label": "Shield / Protection" },
          { "value": "zap", "label": "Clock / Speed" },
          { "value": "tool", "label": "Tool / Install" },
          { "value": "truck", "label": "Truck / Shipping" },
          { "value": "star", "label": "Star / Quality" },
          { "value": "usb", "label": "USB / Charging" },
          { "value": "light", "label": "Light / LED" },
          { "value": "check", "label": "Check / Verified" },
          { "value": "droplet", "label": "Droplet / Waterproof" }
        ]}
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Features"
    }
  ],
  "templates": ["product"]
}
{% endschema %}
