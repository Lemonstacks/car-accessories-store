{% comment %}
  DriveStack Trust — Horizontal strip, left panel + icon grid
{% endcomment %}
{{ 'drivestack-custom.css' | asset_url | stylesheet_tag }}

<section class="ds-trust" aria-label="{{ section.settings.heading | default: 'Why DriveStack' | escape }}">
  <div class="ds-trust__container">
    <div class="ds-trust__header">
      {% if section.settings.heading != blank %}
        <h2 class="ds-trust__title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="ds-trust__subtitle">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="ds-trust__grid">
      {% for block in section.blocks %}
        <div class="ds-trust-item" {{ block.shopify_attributes }}>
          <div class="ds-trust-item__icon" aria-hidden="true">
            {% case block.settings.icon %}
              {% when 'quality' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {% when 'secure' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              {% when 'shipping' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              {% when 'returns' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            {% endcase %}
          </div>
          {% if block.settings.title != blank %}<h3 class="ds-trust-item__title">{{ block.settings.title }}</h3>{% endif %}
          {% if block.settings.description != blank %}<p class="ds-trust-item__description">{{ block.settings.description }}</p>{% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DriveStack Trust",
  "tag": "section",
  "class": "drivestack-trust-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why DriveStack" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Built for drivers who demand the best." }
  ],
  "blocks": [{
    "type": "trust_item", "name": "Trust item", "limit": 6,
    "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Premium Quality" },
      { "type": "text", "id": "description", "label": "Description", "default": "Every product is tested and built to last." },
      { "type": "select", "id": "icon", "label": "Icon", "options": [
        { "value": "quality", "label": "Star" },
        { "value": "secure", "label": "Lock" },
        { "value": "shipping", "label": "Truck" },
        { "value": "returns", "label": "Refresh" },
        { "value": "check", "label": "Checkmark" }
      ], "default": "quality" }
    ]
  }],
  "presets": [{
    "name": "DriveStack Trust",
    "blocks": [
      { "type": "trust_item", "settings": { "title": "Premium Quality", "description": "Every product is tested and built to last.", "icon": "quality" } },
      { "type": "trust_item", "settings": { "title": "Secure Checkout", "description": "Your payment info is always protected.", "icon": "secure" } },
      { "type": "trust_item", "settings": { "title": "Fast Shipping", "description": "Quick delivery right to your door.", "icon": "shipping" } },
      { "type": "trust_item", "settings": { "title": "Easy Returns", "description": "Hassle-free 30-day return policy.", "icon": "returns" } }
    ]
  }]
}
{% endschema %}
